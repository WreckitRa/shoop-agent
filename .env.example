# =========================================================================
# Shopify Commerce — Catalog / Cart / Checkout / Webhooks
# =========================================================================

# Shopify Dev Dashboard → Catalogs → "Get an API key".
# `SHOPIFY_CATALOG_CLIENT_SECRET` doubles as the HMAC secret for webhook
# verification under `/api/webhooks/orders` — keep it server-side only.
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=

# Optional override for the Catalog MCP JSON-RPC URL. Defaults to Shopify's
# global endpoint (`https://catalog.shopify.com/api/ucp/mcp`). Set this only
# if the Dev Dashboard gives you a different URL; a wrong URL returns HTML 404.
# SHOPIFY_CATALOG_MCP_URL=

# Curated shop allowlist for Global Catalog `filters.shop_ids`.
# ON by default (every search_catalog is scoped to curated-shop-ids.ts).
# Set to 0/false/off to search the full Shopify merchant ecosystem.
# CATALOG_SHOP_ALLOWLIST=1
#
# Max shop_ids per search_catalog request (default 100). Large allowlists are
# split into parallel chunked calls. Set to 0 to send the full list in one call.
# CATALOG_SHOP_IDS_CHUNK_SIZE=100

# Optional override for the Catalog UCP agent profile URL.
# Leave unset in production — catalog calls prefer Shopify’s global-capable reference profile.
# If set, MUST be HTTPS with UCP-valid Cache-Control (public + max-age only) and MUST
# declare `dev.shopify.catalog.global` (or get_product will fail with “Tool not found”).
# SHOPIFY_CATALOG_UCP_PROFILE=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json

# Public origin where this app is reachable. Used to build the UCP agent
# profile URL exposed at `/ucp-agent-profile.json`. In production, this MUST
# be HTTPS — merchant MCP servers refuse plain-HTTP profile URLs.
#
# Railway: set this to your generated Railway domain (e.g.
# https://your-app.up.railway.app) BEFORE the first build — Next.js inlines
# NEXT_PUBLIC_* values at build time. Redeploy after changing it.
# Public HTTPS origin (SEO metadataBase, Open Graph, sitemap, robots host).
# Set to your production URL before deploy — required for correct canonicals & social cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local listen port for `npm run dev` (defaults to 3000 if unset).
# Keep in sync with NEXT_PUBLIC_APP_URL when you override it.
# PORT=3002

# Optional explicit HTTPS URL for the UCP agent profile (overrides the value
# derived from NEXT_PUBLIC_APP_URL). Use this when the app is deployed behind
# a CDN/proxy and the public URL differs from the runtime origin.
# AGENT_PROFILE_URL=

# Optional UTM params appended to checkout `continue_url` (ECP builder).
# Leave unset to pass the URL through unchanged.
# SHOPIFY_CONTINUE_URL_UTM_SOURCE=
# SHOPIFY_CONTINUE_URL_UTM_MEDIUM=
# SHOPIFY_CONTINUE_URL_UTM_CAMPAIGN=

# Production: require successful `/.well-known/ucp` discovery for the merchant
# MCP URL — set to "1" to disable the dev-time fallback that guesses
# `/api/ucp/mcp`. Auto-enabled when NODE_ENV=production unless overridden.
# UCP_MCP_REQUIRE_DISCOVERY=1

# =========================================================================
# Buyer-IP forwarding (Shopify Checkout / Order MCP)
# =========================================================================
# Checkout and Order MCP require a real (non-loopback) buyer IP on every
# JSON-RPC POST. In production this is automatic — the platform forwards the
# buyer's IP via X-Forwarded-For / CF-Connecting-IP / similar.
#
# Local dev only: `next dev` typically sees ::1/127.0.0.1, so the request
# would be rejected by Shopify. Set this to your public IP (or use a tunnel)
# to exercise the checkout flow on localhost. NEVER set this in production —
# it would override real buyer IPs and break attribution / fraud signals.
# SHOPIFY_CHECKOUT_BUYER_IP=

# Opt-in diagnostic logging for buyer-IP resolution. Keep OFF in production:
# the payloads include proxy headers that can be sensitive.
# SHOPIFY_DEBUG_CHECKOUT_IP=1

# =========================================================================
# Guest session security
# =========================================================================
# HMAC-SHA256 secret for signing guest session tokens issued by /api/auth/guest.
# Generate with: openssl rand -hex 32
# When set, guest session IDs are signed `{uuid}.{hmac}` — the server rejects
# any unsigned or tampered token, preventing UUID-guessing session impersonation.
# Without this, plain UUIDs are still accepted for backward compatibility.
GUEST_SESSION_HMAC_SECRET=

# =========================================================================
# Supabase Auth (email + password)
# =========================================================================
# Project URL from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (`sb_publishable_…`) — replaces the legacy `anon` key.
# Safe for the browser; used by SSR cookie sessions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (`sb_secret_…`) — replaces the legacy `service_role` key.
# Server-only: account deletion, verification links. Never expose to clients.
SUPABASE_SECRET_KEY=

# In Supabase Dashboard → Authentication → Providers → Email:
# ENABLE “Confirm email”. Signup sends a Resend code/link; there is no
# session until that inbox confirms. Redirect URLs are not required for this.
#
# Resend (Dashboard → API Keys). From-address must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM=Shoop <noreply@shoop.world>

# =========================================================================
# Database (Prisma + Supabase / Postgres)
# =========================================================================
# Use the Supabase Session pooler URL on IPv4-only networks; the direct
# `db.<project-ref>.supabase.co:5432` host is often IPv6-only.
#   Dashboard → Project Settings → Database → Connection string → Session pooler.
# URL-encode special password characters (`#` `@` `:` `/` `?` `%` `$`).
# Append `?sslmode=require` if missing.
DATABASE_URL=

# Optional connection-pool cap (default 5). Supabase's session pooler is
# hard-capped at 15 client connections; multiple Next.js workers can exhaust
# that limit if every worker uses the Prisma default.
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_CONNECT_TIMEOUT=15
# PRISMA_POOL_TIMEOUT=15

# =========================================================================
# Optional Redis (Upstash) — clarification preview cache + warm candidates
# =========================================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# =========================================================================
# Anthropic (chat + memory)
# =========================================================================
ANTHROPIC_API_KEY=

# Optional model overrides — all values are validated against the allowlist
# in `src/lib/ai-chat/constants.ts`.
#
# Tier guide:
# - AI_CHAT_LIGHTWEIGHT_MODEL (Haiku): placeholders, titles, summaries, classifiers
# - AI_CHAT_DEFAULT_MODEL (Opus 4.8 default): main chat replies / post-search narration
# - AI_CHAT_MEMORY_MODEL (Haiku): onboarding profile extraction
#
# AI_CHAT_DEFAULT_MODEL=claude-opus-4-8
# AI_CHAT_LIGHTWEIGHT_MODEL=claude-haiku-4-5-20251001
# AI_CHAT_MEMORY_MODEL=claude-haiku-4-5-20251001

# =========================================================================
# Fashion mode (router + catalog fan-out)
# =========================================================================
# Per query-variant timeout for Shopify MCP search_catalog (default 12000ms).
# Increase if catalog queries time out on slow responses.
# FASHION_CATALOG_QUERY_TIMEOUT_MS=12000
#
# Per get_product hydration call timeout (ms). Default off — calls wait until
# catalog responds (or the request abort). Watch fashion_hydration_get_product
# elapsed_ms in logs, then set e.g. 8000 / 12000 to experiment.
# HYDRATION_CALL_TIMEOUT_MS=0
# HYDRATION_CALL_TIMEOUT_MS=12000
#
# Max in-flight get_product across all slots in one request (default 6).
# HYDRATION_MAX_CONCURRENCY=6
## Fashion LLM overrides — defaults inherit from AI_CHAT_* in constants.ts:
# - FASHION_ROUTER_MODEL → Sonnet 5 (consultation owner)
# - FASHION_SEARCH_PLANNER_MODEL / FASHION_NORMALIZE_MODEL → Haiku 4.5
# - FASHION_TASTE_RERANK_MODEL → Haiku 4.5
# - FASHION_CURATION_MODEL → Sonnet 5
# - SCORING_WEIGHTS_VERSION → v4-taste (v3-brand skips the taste rerank)
# FASHION_ROUTER_MODEL=claude-sonnet-5
# FASHION_SEARCH_PLANNER_MODEL=claude-haiku-4-5-20251001
# FASHION_MEMORY_EXTRACTOR_MODEL=claude-haiku-4-5-20251001
# FASHION_NORMALIZE_MODEL=claude-haiku-4-5-20251001
# FASHION_BRAND_TRANSLATE_MODEL=claude-haiku-4-5-20251001
# FASHION_TASTE_RERANK_MODEL=claude-haiku-4-5-20251001
# FASHION_CURATION_MODEL=claude-sonnet-5
# SCORING_WEIGHTS_VERSION=v4-taste
#
# Anthropic org monthly spend (eval gate + console 80% alert — human).
# EVAL_ORG_MONTHLY_SPEND_LIMIT_USD=2000
# EVAL_ORG_MONTHLY_SPEND_LIMIT_BASELINE_USD=500
# Re-run the router once on Opus when brief invariants trip (accessories
# coercion, unknown common family, validation retry). Off by default.
# FASHION_ROUTER_ESCALATION_ENABLED=1
# FASHION_ROUTER_ESCALATION_MODEL=claude-opus-4-8
# Curation hang-safety (ms). Default 180000 — do NOT lower for snappiness;
# short caps force blind deterministic racks (see cmsod35 Meshki incident).
# CURATION_LLM_TIMEOUT_MS / FASHION_CURATION_SAFETY_MS / FASHION_CURATION_STAGE_A_HARD_MS
# FASHION_CURATION_SAFETY_MS=180000
# CURATION_LLM_TIMEOUT_MS=180000
# Set CURATION_LLM_TIMEOUT_MS=0 only for local debugging (no abort).
# CURATION_LLM_TIMEOUT_MS=0
#
# Other hang-safety ceilings (fail-open; do not raise to chase hung calls):
# FASHION_PLANNER_HARD_MS=15000
# FASHION_NORMALIZE_HARD_MS=15000
# FASHION_HYDRATION_WAVE_HARD_MS=60000
# FASHION_CATALOG_QUERY_HARD_MS=20000
# FASHION_CURATION_STAGE_B_HARD_MS=60000

# =========================================================================
# Admin / operational
# =========================================================================
# Shared-secret token required to perform direct, admin-only mutations of
# message rows via `PATCH /api/messages/:id` (status / content). Leave unset
# to keep the endpoint locked down. The token is matched against the
# `x-ai-chat-admin-token` request header with a constant-time string check.
# AI_CHAT_ADMIN_TOKEN=


# Manual QA tooling (dev only — double-locked with NODE_ENV !== production)
# Comma-separated Supabase auth user UUIDs allowed for /api/dev/qa-reset.
# Seed ACCT-COLD / ACCT-SELF / ACCT-FAMILY (and write this line) via:
#   npm run qa:seed-accounts
# Credentials land in qa-accounts.local.json (gitignored via .env*).
# QA_USER_IDS=

# Fast stale-promote QA lane: hours until hydration verify expires (default 24).
# Example: 0.05 ≈ 3 minutes. Staleness reads candidate.hydrated_at, not created_at.
# VERIFY_TTL_HOURS=0.05

# =========================================================================
# OpenAI (isolated photo-analysis bakeoff — not used for finds)
# =========================================================================
# OPENAI_API_KEY=
# Fast default is gpt-5.4 + medium effort. Set gpt-5.4-pro for a deeper (slower) pass.
# OPENAI_PHOTO_ANALYSIS_MODEL=gpt-5.4

# =========================================================================
# Virtual try-on (FASHN only — face-to-model avatar + dress)
# =========================================================================
# FASHN_API_KEY=
# FASHN_TRYON_MODEL=tryon-max
# FASHN_TIMEOUT_MS=120000
# NEXT_PUBLIC_TRYON_POLL_MAX_MS=360000
#
# Try-on is enabled by default. Set TRYON_ENABLED=0 to disable globally.
# Optional gradual rollout: TRYON_USER_IDS=uuid-1,uuid-2
# TRYON_OUTFITS_ENABLED=0
#
# Cost guardrails:
# TRYON_USER_DAILY_CAP=30
# TRYON_GLOBAL_DAILY_SPEND_CAP=50

# Photo upload cost / abuse guards
# Per-user and per-IP UTC-day caps on /api/onboarding/photo-analysis and /api/avatar/upload.
# PHOTO_UPLOAD_USER_DAILY_CAP=8
# PHOTO_UPLOAD_IP_DAILY_CAP=20
# Estimated OpenAI photo-pipeline ceiling (preflight + analysis + stylist verdict).
# PHOTO_MODEL_DAILY_SPEND_CAP=40
# Email when FASHN or photo-model daily spend caps trip (Danny).
# OPS_ALERT_EMAIL=danny@shoop.world
# DANNY_ALERT_EMAIL=danny@shoop.world
#
# Private Supabase storage bucket (create as non-public):
# TRYON_STORAGE_BUCKET=tryon-private
#
# Force mock providers in dev:
# TRYON_USE_MOCKS=1
#
# Dress try-on terminal logs (compare_started, provider_processing, poll_status, …):
# Enabled in development by default; set TRYON_DEBUG=1 to force in other environments.
# TRYON_DEBUG=1
